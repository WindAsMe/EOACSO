\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Worked example of the encoding and decoding pipeline. A continuous particle position of length $5+D+5$ splits into $5$ transfer function scores ($t_1,\dots  ,t_5$), $D$ feature scores ($f_1,\dots  ,f_D$), and 5 classifier scores ($c_1,\dots  ,c_5$). Each segment passes through a transfer function to produce a binary string; thresholded-off features/classifiers (0) are excluded, and the remainder (1, highlighted) are decoded into a feature mask, here selecting the sub-dataset restricted to columns $f_2, f_3, \ldots  , f_{D-1}, f_D$, and a classifier mask, here selecting SVM and KNN. Every classifier in the mask trains on the same feature subset and is combined by equal-weight soft voting before 5-fold subject-grouped cross-validation.}}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:3.3.1}{{1}{6}{Worked example of the encoding and decoding pipeline. A continuous particle position of length $5+D+5$ splits into $5$ transfer function scores ($t_1,\dots ,t_5$), $D$ feature scores ($f_1,\dots ,f_D$), and 5 classifier scores ($c_1,\dots ,c_5$). Each segment passes through a transfer function to produce a binary string; thresholded-off features/classifiers (0) are excluded, and the remainder (1, highlighted) are decoded into a feature mask, here selecting the sub-dataset restricted to columns $f_2, f_3, \ldots , f_{D-1}, f_D$, and a classifier mask, here selecting SVM and KNN. Every classifier in the mask trains on the same feature subset and is combined by equal-weight soft voting before 5-fold subject-grouped cross-validation}{figure.caption.1}{}}
\newlabel{fig:3.3.1@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
