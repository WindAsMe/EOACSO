% --------------------------------------------------------------------
% Little:2008: CITATION AMBIGUITY -- READ BEFORE USING
% --------------------------------------------------------------------
% This project's Oxford dataset (195 recordings / 31 subjects / 22
% features, UCI ID 174) is conventionally cited as:
%
%   Little MA, McSharry PE, Roberts SJ, Costello DAE, Moroz IM (2007).
%   "Exploiting Nonlinear Recurrence and Fractal Scaling Properties for
%   Voice Disorder Detection." BioMedical Engineering OnLine, 6:23.
%   https://doi.org/10.1186/1475-925X-6-23
%
% This is the entry below. HOWEVER: the Al-Najjar et al. (2024) paper's
% own reference list cites the SAME dataset as "Little M, McSharry P,
% Hunter E, Spielman J, Ramig L. Suitability of dysphonia measurements
% for telemonitoring of Parkinson's disease. Nature Prec. 2008" with DOI
% 10.1109/TBME.2008.2005954 -- that DOI actually resolves to a DIFFERENT,
% later IEEE Trans. Biomed. Eng. (2009) paper by an overlapping set of
% authors, about a much larger telemonitoring dataset (5875 recordings
% with UPDRS scores), not the 195-sample dataset used here. This looks
% like a citation error in that paper (conflating two different Little
% et al. datasets), not a real alternative citation -- I have NOT
% verified the 2009 TBME paper's content myself, so treat this note as
% a flag to double check, not a settled fact. Use the entry below unless
% your own check of the UCI page / BioMed Eng OnLine paper says otherwise.
% --------------------------------------------------------------------
@article{Little:2008,
  author  = {Little, Max A. and McSharry, Patrick E. and Roberts, Stephen J. and Costello, Declan A. E. and Moroz, Irene M.},
  title   = {Exploiting Nonlinear Recurrence and Fractal Scaling Properties for Voice Disorder Detection},
  journal = {BioMedical Engineering OnLine},
  year    = {2007},
  volume  = {6},
  pages   = {23}
}

