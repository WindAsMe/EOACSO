#!/bin/bash
#PBS -N cso-phi-sensitivity
#PBS -q sc
#PBS -l select=1:nsockets=1
#PBS -l walltime=23:30:00
#PBS -W group_list=c30636
#PBS -j oe

# CSO_searched_tf only, phi in {0.0, 0.05, ..., 0.50} (11 values), n_runs=20,
# both datasets -- 440 runs total. Scoped to the proposed method: phi (CSO's
# social-term coefficient, Cheng & Jin 2015 Eq. 25-26) doesn't exist in any
# of the 7 reproduced baselines. Every (phi, dataset, run) triple is
# independent -- run_phi_values() already parallelizes them across a
# ProcessPoolExecutor internally, so one 1-socket job is the right shape, no
# job array needed. Resource syntax matches run_comparison.pbs (see that
# file's header comment).
#
# walltime was originally 6h on the same wrong "finishes in a few hours"
# assumption as run_comparison.pbs -- actual `elapsed_sec` in
# results/tables/*_phi_sensitivity_results.csv shows 6,000-21,000s (1.7-5.8h)
# per single (phi, dataset, run) triple (multi_hot classifier_encoding
# trains several classifiers per fitness evaluation, x up to 3000
# evaluations), so the 6h job only got ~20 of the needed 440 rows done
# before "PBS: job killed: walltime ... exceeded limit ...". 23:30 (just
# under sc's 24h resources_max.walltime) gives each attempt ~6-7x more
# room; at ~15,000s/run x 32 workers, expect ~3 submissions total to finish
# all 440 rows (`--resume` below means a walltime-kill never loses
# already-completed rows -- just `qsub` this file again).

set -euo pipefail
NCPUS=32

cd "$PBS_O_WORKDIR"
mkdir -p logs results/tables

source "$HOME/miniconda3/bin/activate" eoacso

python -m src.experiments.run_phi_sensitivity \
    --dataset oxford naranjo \
    --n_runs 20 \
    --pop_size 30 \
    --max_evaluations 3000 \
    --base_seed 2026 \
    --cv_folds 5 \
    --n_workers "$NCPUS" \
    --resume
