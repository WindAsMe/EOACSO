#!/bin/bash
#PBS -N cso-comparison
#PBS -q sc
#PBS -l select=1:nsockets=1
#PBS -l walltime=23:30:00
#PBS -W group_list=c30636
#PBS -j oe

# CSO_searched_tf vs. 7 reproduced baselines, n_runs=20, both datasets.
# Every (algorithm, dataset, run) triple is independent -- run_algorithms()
# already parallelizes them across a ProcessPoolExecutor internally, so one
# 1-socket job is the right shape -- no job array needed. This cluster's
# resource syntax is nsockets= (CPU sockets), not ncpus=/mem= (confirmed via
# the cluster's own user guide, gakusai_Users_Guide_ja_1.1.pdf, section 5.3/
# 5.4 -- every sample script there uses nsockets=, never ncpus= or mem=).
# 1 socket = 32 cores on this hardware (matches default_chunk.ncpus=32 from
# `qstat -Qf sc`/`qstat -Qf lc`). NCPUS below MUST match that core count
# (each worker is pinned to 1 BLAS thread; see _limit_threads_per_worker in
# run_fs_experiment.py).
#
# walltime was originally a "deliberately modest" 6h, on the assumption
# this job would realistically finish in a few hours -- that assumption was
# WRONG and cost a full 6h job attempt with almost nothing to show for it.
# A real run (`elapsed_sec` in results/tables/*_comparison_results.csv)
# takes 6,000-21,000s (1.7-5.8h) per single (algorithm, dataset, run)
# triple under multi_hot classifier_encoding (several classifiers, one with
# CalibratedClassifierCV, trained per fold per fitness evaluation, x up to
# 3000 evaluations) -- 32-way parallelism only runs MORE OF THESE triples
# at once, it doesn't make any one of them faster, so a 6h window only let
# each of the 32 workers barely finish 1 triple before getting killed
# ("PBS: job killed: walltime ... exceeded limit ..."), leaving only ~20 of
# the needed 320 rows on disk. 23:30 (just under sc's 24h
# resources_max.walltime) gives each attempt roughly 6-7x more room; at
# ~15,000s/run x 32 workers, expect ~2 submissions total to finish all 320
# rows (`--resume` below means a walltime-kill never loses already-completed
# rows -- just `qsub` this file again and it picks up where it left off).
# This also reserves ~4x more prepaid token budget per attempt than the old
# 6h setting (see gakusai_Users_Guide_ja_1.1.pdf 1.6.1) -- run `show_token`
# before resubmitting if unsure of remaining balance.

set -euo pipefail
NCPUS=32

cd "$PBS_O_WORKDIR"
mkdir -p logs results/tables

source "$HOME/miniconda3/bin/activate" eoacso

python -m src.experiments.run_comparison \
    --dataset oxford naranjo \
    --n_runs 20 \
    --pop_size 30 \
    --max_evaluations 3000 \
    --base_seed 2026 \
    --cv_folds 5 \
    --n_workers "$NCPUS" \
    --resume
